{
  "expo": {
    "name": "LightTokenz",
    "slug": "lighttokenz",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0a17",
    "ios": {
      "bundleIdentifier": "com.lighttokenz.app",
      "supportsTablet": true,
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.lighttokenz.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0a17"
      },
      "allowBackup": true
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0c0a17",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0c0a17"
          }
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3d63ff"
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Moduły Expo i biblioteki natywne używają refleksji i nazw klas z JS: zostają w całości.\n-keep class expo.modules.** { *; }\n-keep class eightbitlab.com.blurview.** { *; }\n-keep class com.reactnativecommunity.asyncstorage.** { *; }\n-keep class com.th3rdwave.safeareacontext.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "snapshotUrls": [
        "https://raw.githubusercontent.com/nitve1/mfkig-notatnik/tanitoken-data/snapshot.json",
        "https://raw.githubusercontent.com/nitve1/mfkig-notatnik/claude/hopeful-gauss-8su545/tanitoken/data/snapshot.json",
        "https://nitve1.github.io/mfkig-notatnik/tanitoken/data/snapshot.json"
      ]
    }
  }
}
